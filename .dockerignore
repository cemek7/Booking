# Build context exclusions for deployment/Dockerfile.vps.
#
# The builder stage does `COPY . .`, so anything not excluded here is uploaded to
# the Docker daemon on every build. node_modules alone was ~1.3GB of that, and it
# is redundant: the deps stage installs its own copy via `npm ci`.
#
# Do NOT exclude: src/, public/, scripts/, next.config.mjs, package*.json,
# tsconfig*.json, sentry.*.config.ts — the production build needs all of them.

# Dependencies — reinstalled by the deps/runner stages
node_modules
**/node_modules

# Build output — regenerated by `npm run build`
.next
out
dist
.tsbuild
.turbo

# Version control
.git
.gitignore
.github

# Secrets — must never enter an image layer
.env
.env.*
!.env.example
!env.example

# Tests and coverage — not part of the production build graph
tests
cypress
coverage
playwright-report
test-results
src/__tests__
src/test
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Editor / tooling / agent state
.vscode
.idea
.claude
.codex
.superpowers
.design-sync-stage

# Docs and local artifacts
docs
*.md
!README.md
*.log
*.pdf
