# Copy this file to .secrets.handoff.env, fill it outside chat, then install it
# with deployment/scripts/install-runtime-secrets.sh on the VPS. This file is
# only a template; it contains no real credentials.

# Meta / WhatsApp shared-gateway staging pilot
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_SHARED_GATEWAY_PHONE_NUMBER_ID=
ENCRYPTION_KEY=

# Booka-generated deployment secrets. Create/persist them on the VPS with:
# deployment/scripts/ensure-generated-runtime-secrets.sh staging
STOREFRONT_CONTEXT_SECRET=
NEXTAUTH_SECRET=
CRON_SECRET=
JWT_SECRET=
INSTAGRAM_OAUTH_STATE_SECRET=
REDIS_PASSWORD=

# Optional identifiers; these are not secret but keep them with the connection.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
