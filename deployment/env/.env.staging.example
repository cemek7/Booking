COMPOSE_PROJECT_NAME=booka-staging
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
APP_PORT=3100
APP_IMAGE=ghcr.io/OWNER/REPO:staging-latest
APP_PUBLIC_URL=https://staging.app.techclave.cloud

APP_URL=https://staging.app.techclave.cloud
NEXT_PUBLIC_APP_URL=https://staging.app.techclave.cloud
NEXT_PUBLIC_BASE_URL=https://staging.app.techclave.cloud

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

REDIS_PASSWORD=change-me
CRON_SECRET=change-me
STOREFRONT_CONTEXT_SECRET=
ENABLE_CRON=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mail.techclave.cloud

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta / WhatsApp Cloud API staging
# Meta webhook callback: https://staging.app.techclave.cloud/api/webhooks/whatsapp/meta
DEFAULT_WHATSAPP_PROVIDER=meta
ENABLE_WHATSAPP_INTEGRATION=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
# Optional Booka-owned shared gateway number for routing-code pilot testing.
# Leave empty for dedicated tenant Meta numbers.
META_SHARED_GATEWAY_PHONE_NUMBER_ID=

# Instagram API with Instagram Login staging
# OAuth redirect URI: https://staging.app.techclave.cloud/api/auth/instagram/callback
# Meta webhook callback: https://staging.app.techclave.cloud/api/webhooks/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_OAUTH_REDIRECT_URI=https://staging.app.techclave.cloud/api/auth/instagram/callback
INSTAGRAM_OAUTH_STATE_SECRET=

# Meta Embedded Signup — set only after Meta gives Booka a Partner/Tech Provider
# configuration ID. Client payment methods remain owned by each tenant's WABA.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Public Embedded Signup IDs are returned by Booka's authenticated runtime API;
# no NEXT_PUBLIC_META_* build-time values are needed.

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# ==============================================================================
# WhatsApp message metering (Meta bills service messages from 2026-10-01)
# ==============================================================================
# shadow = record volume, never gate or charge. live = full metering.
BOOKA_MESSAGE_METERING_MODE=shadow
# What Booka pays Meta per delivered message, in credits (1 credit = NGN 1).
# PROVISIONAL. Meta publishes confirmed Nigeria rates on 2026-09-01.
BOOKA_MESSAGE_RATE_CREDITS=14
# Resale multiplier: FX drift, BSP and tax overhead, failed sends, margin.
BOOKA_MESSAGE_MARKUP=1.6
# Default grace overdraft for new wallets, in credits.
BOOKA_MESSAGE_GRACE_CREDITS=100
# Monthly reconciliation alert threshold, percent.
BOOKA_MESSAGE_RECONCILE_DRIFT_PCT=2
# How long a wallet-exhausted handoff keeps one conversation quiet before the
# customer may be handed off again. Also re-arms early on any wallet credit.
BOOKA_WALLET_HANDOFF_REARM_HOURS=24
