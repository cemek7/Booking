COMPOSE_PROJECT_NAME=booka-prod
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
APP_PORT=3200
APP_IMAGE=ghcr.io/OWNER/REPO:production-latest
APP_PUBLIC_URL=https://app.techclave.cloud

APP_URL=https://app.techclave.cloud
NEXT_PUBLIC_APP_URL=https://app.techclave.cloud
NEXT_PUBLIC_BASE_URL=https://app.techclave.cloud

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

REDIS_PASSWORD=change-me
CRON_SECRET=change-me
STOREFRONT_CONTEXT_SECRET=
ENABLE_CRON=true

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mail.techclave.cloud

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=

# WhatsApp Cloud API webhook. These are the names read by
# /api/webhooks/whatsapp/meta; META_VERIFY_TOKEN alone does not verify Meta's
# callback challenge.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0

# Meta Embedded Signup — production values after Partner/Tech Provider approval.
# Do not set or store client payment-card details in Booka.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Public Embedded Signup IDs are returned by Booka's authenticated runtime API;
# no NEXT_PUBLIC_META_* build-time values are needed.

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# ==============================================================================
# WhatsApp message metering (Meta bills service messages from 2026-10-01)
# ==============================================================================
# shadow = record volume, never gate or charge. live = full metering.
BOOKA_MESSAGE_METERING_MODE=shadow
# What Booka pays Meta per delivered message, in credits (1 credit = NGN 1).
# PROVISIONAL. Meta publishes confirmed Nigeria rates on 2026-09-01.
BOOKA_MESSAGE_RATE_CREDITS=14
# Resale multiplier: FX drift, BSP and tax overhead, failed sends, margin.
BOOKA_MESSAGE_MARKUP=1.6
# Default grace overdraft for new wallets, in credits.
BOOKA_MESSAGE_GRACE_CREDITS=100
# Monthly reconciliation alert threshold, percent.
BOOKA_MESSAGE_RECONCILE_DRIFT_PCT=2
# How long a wallet-exhausted handoff keeps one conversation quiet before the
# customer may be handed off again. Also re-arms early on any wallet credit.
BOOKA_WALLET_HANDOFF_REARM_HOURS=24
