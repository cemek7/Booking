# Versioned copy of the unit installed at /etc/systemd/system/. Install with:
#   sudo install -m 644 deployment/vps/systemd/booka-production-image-refresh.* /etc/systemd/system/
#   sudo systemctl daemon-reload
[Unit]
Description=Refresh Booka production from the latest published immutable production image
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=STACK_ROOT=/opt/techclave
Environment=DEPLOY_TARGET=production
Environment=STACK_SUBDIR=prod
Environment=CONTAINER_NAME=booka-prod-app
Environment=REPO_DIR=/opt/Booking
Environment=BRANCH_NAME=main
Environment=IMAGE_CHANNEL=production
Environment=CLEANUP_DOCKER=true
ExecStart=/usr/bin/flock -n /run/booka-production-image-refresh.lock /usr/local/bin/techclave-refresh-image --remote
