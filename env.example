# BOKA BOOKING SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` and fill in real values. DO NOT COMMIT SECRETS.
# 
# For production deployments, use your CI/CD secret manager (GitHub Secrets, GitLab Variables, etc.)
# Local development: Copy to .env.local and update with your credentials
#
# REQUIRED: Supabase, JWT_SECRET, WEBHOOK_SIGNATURE_SECRET, ENCRYPTION_KEY
# OPTIONAL: WhatsApp, LLM services, Payment providers, Observability
# 
# See: src/lib/config/env.ts for validation schema and type definitions

# ============================================================================
# REQUIRED - AUTHENTICATION & DATABASE
# ============================================================================

# Supabase Configuration (REQUIRED)
# Get from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Security Keys (REQUIRED for production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here
WEBHOOK_SIGNATURE_SECRET=your-webhook-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application URLs
NEXT_PUBLIC_HOST=localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3001
# Canonical app URL used in generated links (e.g. review request emails)
APP_URL=http://localhost:3000

# Environment
NODE_ENV=development
# Options: development | staging | production

# ============================================================================
# OPTIONAL - DATABASE ADDITIONAL CONFIGURATION
# ============================================================================

# Only needed if using direct database connection (advanced)
DATABASE_URL=
DIRECT_URL=

# ============================================================================
# OPTIONAL - REDIS (Required for messaging and caching)
# ============================================================================

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================================
# CRON / BACKGROUND JOBS
# ============================================================================

# Secret sent in x-cron-secret header by Vercel Cron / external scheduler
# Protects POST /api/jobs/process and POST /api/jobs/auto-cancel-unconfirmed
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ============================================================================
# OPTIONAL - WHATSAPP INTEGRATION (Evolution API)
# ============================================================================

# WhatsApp messaging requires Evolution API credentials
# Get from your self-hosted Evolution API instance (evolution-api-lite/)
#
# EVOLUTION_WEBHOOK_SECRET must match the secret configured in Evolution API
# so that POST /api/webhooks/evolution can verify incoming payloads.
# Without this the webhook returns 500 and messages are never processed.
# Generate with: openssl rand -hex 32
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_API_BASE=http://localhost:8080
EVOLUTION_INSTANCE_NAME=booka_instance
EVOLUTION_INSTANCE_KEY=
WHATSAPP_API_KEY=

# WAHA Core (server-managed; tenants do not supply these)
WAHA_API_BASE=http://localhost:3100
WAHA_API_KEY=
# Optional hard allowlist of WAHA hosts (host[:port], comma-separated)
WAHA_ALLOWED_BASE_HOSTS=localhost:3100
# Auto-provision WAHA endpoint assignment for new tenants during onboarding
WAHA_AUTO_PROVISION_ENABLED=true
# If true, tenant creation fails when WAHA provisioning fails
WAHA_AUTO_PROVISION_REQUIRED=false
# Allow sharing one WAHA endpoint across tenants (not recommended with Core)
WAHA_ALLOW_SHARED_ENDPOINTS=false
# Optional tenant->endpoint map JSON (backend only). Example:
# {"<tenant-uuid>":{"baseUrl":"http://waha-tenant-a:3000","apiKey":"k1"},"default":{"baseUrl":"http://waha-default:3000","apiKey":"k2"}}
WAHA_TENANT_ENDPOINTS_JSON=
# Optional endpoint pool JSON for auto-assignment (first unused endpoint picked)
# Example: [{"baseUrl":"http://waha-tenant-a:3000","apiKey":"k1"},{"baseUrl":"http://waha-tenant-b:3000","apiKey":"k2"}]
WAHA_CORE_ENDPOINT_POOL_JSON=
# Optional external infra provisioner webhook
WAHA_PROVISIONER_WEBHOOK_URL=
WAHA_PROVISIONER_TOKEN=
# Provider selected when tenant has no WhatsApp config yet
DEFAULT_WHATSAPP_PROVIDER=waha

# Meta Cloud API (optional; required when DEFAULT_WHATSAPP_PROVIDER=meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# Instagram (Instagram API with Instagram Login; Graph API v25.0)
# From the Meta app dashboard's Instagram product (these are Instagram-scoped, not the
# WhatsApp app id/secret). See docs/instagram-meta-setup-guide.md.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Token you choose and enter in the IG webhook config (GET handshake).
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# OAuth redirect; defaults to ${APP_URL}/api/auth/instagram/callback if left blank.
INSTAGRAM_OAUTH_REDIRECT_URI=
# Optional dedicated secret for signing the OAuth state (falls back to NEXTAUTH_SECRET/CRON_SECRET).
INSTAGRAM_OAUTH_STATE_SECRET=

# ============================================================================
# OPTIONAL - LLM SERVICES (for AI features)
# ============================================================================

# Google AI Studio (Gemini) — primary LLM provider (more reliable, generous free tier)
# Get API key: https://aistudio.google.com/app/apikey
# Free: 15 RPM, 1M tokens/min, 1500 req/day. When set, takes priority over OpenRouter.
GOOGLE_AI_API_KEY=
# Optional: gemini-2.0-flash (default) | gemini-1.5-flash | gemini-1.5-flash-8b | gemini-1.5-pro
GOOGLE_AI_DEFAULT_MODEL=

# OpenRouter API — fallback when Google AI is not configured
# Get from: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.openrouter.ai
OPENROUTER_REFERER=https://chat.openrouter.ai
OPENROUTER_URL=https://api.openrouter.ai/v1
OPENROUTER_MODEL=gpt-4o-mini

# WhatsApp v2 AI provider preference:
# auto (default): try Google then fallback OpenRouter
# openrouter: OpenRouter first; if WHATSAPP_V2_DISABLE_GOOGLE=true then Google is fully skipped
# google: Google only
WHATSAPP_V2_AI_PROVIDER=auto
WHATSAPP_V2_DISABLE_GOOGLE=false
# Optional: comma-separated model chain for v2 OpenRouter fallback attempts (left-to-right)
# Example: openai/gpt-4.1-mini,openai/gpt-4.1-nano,openai/gpt-4o-mini
OPENROUTER_V2_FALLBACK_MODELS=
# Disable the legacy in-process WhatsApp messageProcessor when using v2 cron worker pipeline
WHATSAPP_V2_DISABLE_LEGACY_PROCESSOR=false

# OpenAI API (alternative)
# Get from: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local LLM (for offline use)
LOCAL_LLM_MODEL=./models/distilgpt2

# ============================================================================
# OPTIONAL - PAYMENT PROVIDERS
# ============================================================================

# Paystack Configuration
# Get from: https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Platform fee percentage kept by superadmin on every Paystack split payment (0-100)
PAYSTACK_PLATFORM_FEE_PERCENT=5

# Stripe Configuration
# Get from: https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave (optional alternative payment provider)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ============================================================================
# OPTIONAL - OBSERVABILITY & MONITORING
# ============================================================================

# OpenTelemetry OTLP exporters (used by src/lib/observability/node-observability.ts)
# Traces endpoint — e.g. http://localhost:4318/v1/traces (Grafana Agent, Jaeger, etc.)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Metrics endpoint — e.g. http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# Application version passed to the OTLP resource attributes
APP_VERSION=1.0.0

# Sentry (Error tracking and monitoring)
# Get from: https://sentry.io
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry browser DSN (required for client-side error capture)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (product analytics + session replay; consent-gated)
# Get from: https://posthog.com -> Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Metrics API auth token (protects GET /api/metrics)
METRICS_SECRET=

# ============================================================================
# OPTIONAL - SOCIAL LISTENING
# ============================================================================

# Provider used by GET /api/cron/social-listening
# Options: stub | google_pse
SOCIAL_LISTENING_PROVIDER=stub

# Google Programmable Search JSON API (spike-friendly, hedge-friendly)
# Official docs: https://developers.google.com/custom-search/v1/overview
# Free tier: 100 queries/day, then paid with billing enabled.
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
# Google Custom Search API caps num at 10.
GOOGLE_PSE_RESULT_LIMIT=10

# ============================================================================
# OPTIONAL - EXTERNAL SERVICES
# ============================================================================

# n8n Webhook (automation)
N8N_CHAT_WEBHOOK=

# Slack Integration
SLACK_WEBHOOK_URL=

# Email — SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Calendar OAuth (optional — for tenant calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ============================================================================
# FEATURE FLAGS (Control feature availability)
# ============================================================================

# WhatsApp messaging integration
ENABLE_WHATSAPP_INTEGRATION=false
# Options: true | false

# Phase 5 advanced features
ENABLE_PHASE5_FEATURES=true
# Options: true | false

# Analytics dashboard
ENABLE_ANALYTICS_DASHBOARD=true
# Options: true | false

# Messaging adapter
ENABLE_MESSAGING_ADAPTER=false
# Options: true | false

# Advanced scheduler
ENABLE_ADVANCED_SCHEDULER=true
# Options: true | false

# ============================================================================
# IMPORTANT NOTES
# ============================================================================

# SECURITY BEST PRACTICES:
# 1. NEVER commit this file with real secrets - use .env.local for local development
# 2. For production, use your deployment platform's secret manager:
#    - GitHub Actions: Settings > Secrets > Actions
#    - GitLab CI: Settings > CI/CD > Variables
#    - Vercel: Project Settings > Environment Variables
#    - Netlify: Site Settings > Build & Deploy > Environment
# 3. Rotate secrets regularly, especially WEBHOOK_SIGNATURE_SECRET and JWT_SECRET
#
# NEXT_PUBLIC_ VARIABLES:
# - These are exposed to the browser, so NEVER put secret keys in them
# - Only use for public configuration (URLs, feature flags, app URLs)
# - Examples: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY (anon = safe)
#
# SERVICE REQUIREMENTS:
# - Supabase: REQUIRED for all deployments
# - Redis: REQUIRED for messaging and caching features
# - JWT_SECRET: REQUIRED for session management
# - Webhook secrets: REQUIRED for payment and integration security
#
# BOOLEAN FLAGS:
# - Must be literal 'true' or 'false' strings (not 1/0)
# - Will be converted to boolean in src/lib/config/env.ts
#
# VALIDATION:
# - Environment is validated at startup via src/lib/config/env.ts
# - Missing required variables will cause startup error with clear message
# - Type checking provides autocomplete and safety in code


# ─── v2 WhatsApp-native feature layer ─────────────────────────────────────────

# Health alerts via Telegram (optional — skip if not needed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Per-day AI call budgets (across all tenants combined)
AI_LITE_DAILY_BUDGET=800
AI_FLASH_DAILY_BUDGET=200

# The phone number attached to the Evolution instance (used in booking links)
# Format: country code + number, no + or spaces (e.g. 2348012345678)
EVOLUTION_DEFAULT_PHONE=2348000000000

# Cloudflare R2 backup (optional — nightly export of tenant data)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=booka-backups
