# ==============================================================================
# Boka Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# Required vars are marked [REQUIRED]. Optional vars can be left blank.
# ==============================================================================

# ==============================================================================
# Supabase (database + auth)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co    # [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                   # [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key               # [REQUIRED] server only
SUPABASE_URL=https://your-project.supabase.co                 # [REQUIRED] server alias
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres  # direct DB URL
DIRECT_URL=postgresql://postgres:password@db.supabase.co:5432/postgres    # for migrations

# ==============================================================================
# App
# ==============================================================================
NEXT_PUBLIC_HOST=http://localhost:3000                         # [REQUIRED]
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-min-32-chars                       # [REQUIRED]
ENCRYPTION_KEY=your-32-byte-hex-encryption-key                # [REQUIRED]
CRON_SECRET=your-cron-secret                                  # protects cron routes
METRICS_BACKEND=prometheus

# ==============================================================================
# Payments — Stripe
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# Payments — Paystack
# ==============================================================================
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# ==============================================================================
# Payments — Flutterwave
# ==============================================================================
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...

# ==============================================================================
# WhatsApp (Evolution API)
# ==============================================================================
EVOLUTION_API_BASE=https://api.evolution-api.com              # canonical URL
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_KEY=your-instance-key
EVOLUTION_INSTANCE_NAME=your-instance-name
EVOLUTION_WEBHOOK_SECRET=your-webhook-secret

# WhatsApp (WAHA Core)
# Global fallback endpoint/key used when no per-tenant mapping exists.
WAHA_API_BASE=http://localhost:3100
WAHA_API_KEY=your-waha-api-key
# Optional hard allowlist of WAHA hosts (host[:port], comma-separated).
WAHA_ALLOWED_BASE_HOSTS=localhost:3100
# Auto-provision WAHA endpoint assignment for new tenants on onboarding.
WAHA_AUTO_PROVISION_ENABLED=true
# If true, tenant creation fails when WAHA auto-provisioning fails.
WAHA_AUTO_PROVISION_REQUIRED=false
# Optional: allow shared WAHA endpoint across tenants (not recommended with Core single-session).
WAHA_ALLOW_SHARED_ENDPOINTS=false
# Optional per-tenant endpoint map (backend-only). Example:
# {"<tenant-uuid>":{"baseUrl":"http://waha-tenant-a:3000","apiKey":"k1"},"default":{"baseUrl":"http://waha-default:3000","apiKey":"k2"}}
WAHA_TENANT_ENDPOINTS_JSON=
# Optional endpoint pool for automatic unique assignment (first free endpoint is used).
# Example: [{"baseUrl":"http://waha-tenant-a:3000","apiKey":"k1"},{"baseUrl":"http://waha-tenant-b:3000","apiKey":"k2"}]
WAHA_CORE_ENDPOINT_POOL_JSON=
# Optional external provisioner webhook (spins infrastructure and returns baseUrl/apiKey).
WAHA_PROVISIONER_WEBHOOK_URL=
WAHA_PROVISIONER_TOKEN=
# Provider selected when tenant has no existing whatsapp_configurations row.
DEFAULT_WHATSAPP_PROVIDER=waha

# ==============================================================================
# WhatsApp (Meta Cloud API — optional alternative)
# ==============================================================================
WHATSAPP_ACCESS_TOKEN=EAAxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_KEY=your-api-key
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BASE_URL=https://graph.facebook.com
# Optional interim multi-tenant gateway. Do not map this phone ID to a tenant in
# whatsapp_configurations: unmapped inbound messages are routed by tenant code
# and replies are sent from this Booka number.
META_SHARED_GATEWAY_PHONE_NUMBER_ID=

# Meta Embedded Signup (Partner / Tech Provider path; server secrets stay server-only)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# The authenticated settings endpoint supplies the public App/Config IDs at
# runtime. Do not add NEXT_PUBLIC_META_* values as Docker build arguments.

# ==============================================================================
# LLM / AI (OpenRouter — used for conversation AI & summarization)
# ==============================================================================
OPENROUTER_API_KEY=sk-or-...                                  # [REQUIRED for AI features]
OPENROUTER_BASE_URL=https://openrouter.ai/api                 # canonical base URL
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=openai/gpt-3.5-turbo
OPENROUTER_REFERER=https://your-app.com
OPENROUTER_DEFAULT_TOKEN_RATE=0.000002
OPENROUTER_MODEL_TOKEN_RATE=0.000002

# ==============================================================================
# LLM / AI — Cloudflare Workers AI (optional; preferred by auto routing)
# Create a token with Workers AI Read and Edit permissions for this account.
# Models use the @cf/ prefix from the Workers AI model catalog.
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_AI_FALLBACK_MODELS=
# Optional: route Cloudflare requests through an AI Gateway by ID.
CLOUDFLARE_AI_GATEWAY_ID=
# WhatsApp v2 provider: cloudflare | openrouter | google | auto.
# auto tries Cloudflare, then OpenRouter, then Google AI when configured.
WHATSAPP_V2_AI_PROVIDER=auto

# ==============================================================================
# LLM / AI — OpenAI (direct, optional)
# ==============================================================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ==============================================================================
# LLM / AI — Local LLM (optional)
# ==============================================================================
LOCAL_LLM_MODEL=llama3

# ==============================================================================
# Email (Resend)
# ==============================================================================
RESEND_API_KEY=re_....
EMAIL_DEFAULT_FROM=noreply@mail.techclave.cloud
EMAIL_SUPPORT_FROM=support@mail.techclave.cloud
EMAIL_SECURITY_FROM=security@mail.techclave.cloud
EMAIL_BOOKINGS_FROM=bookings@mail.techclave.cloud
EMAIL_BILLING_FROM=billing@mail.techclave.cloud
EMAIL_NEWSLETTER_FROM=newsletter@mail.techclave.cloud
EMAIL_UPDATES_FROM=updates@mail.techclave.cloud
# Backward compatibility fallback (legacy)
RESEND_FROM_EMAIL=noreply@mail.techclave.cloud

# ==============================================================================
# SMS (Twilio)
# ==============================================================================
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# Redis (optional — enables BullMQ job queues and caching)
# For Docker-on-VPS launches, point this at the Redis container on the host:
#   REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/0
#   REDIS_ENABLED=true
# ==============================================================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================================================
# Google Calendar (optional)
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# ==============================================================================
# Observability (optional)
# ==============================================================================
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
PUSHGATEWAY_URL=http://localhost:9091
SENTRY_DSN=https://xxxx@sentry.io/project
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/project
SENTRY_ORG=your-org
SENTRY_PROJECT=boka
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ==============================================================================
# File storage
# ==============================================================================
# This launch path does not require S3. Leave these unset unless you explicitly
# wire an object storage backend for uploads, backups, or exports.
# AWS_ACCESS_KEY_ID=
# AWS_S3_BUCKET=

# ==============================================================================
# Feature flags (optional, defaults to false)
# ==============================================================================
ENABLE_WHATSAPP_INTEGRATION=false
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_ADVANCED_SCHEDULER=false
ENABLE_MESSAGING_ADAPTER=false
HIPAA_ENABLED=false
LOG_REQUESTS=false

# ==============================================================================
# Webhooks / Security
# ==============================================================================
WEBHOOK_SIGNATURE_SECRET=your-webhook-signature-secret

# ==============================================================================
# App defaults
# ==============================================================================
DEFAULT_COUNTRY_CODE=NG
DEFAULT_TENANT_ID=
NEXTAUTH_URL=http://localhost:3000
